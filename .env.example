# Required: create a Telegram bot with @BotFather and paste the token here.
TELEGRAM_BOT_TOKEN=

# Optional. Leave blank, start the program, then send /start to your bot.
TELEGRAM_CHAT_ID=

# Strongly recommended for true new-listing discovery.
# Create a Birdeye API key and paste it here.
BIRDEYE_API_KEY=

# Scanner settings
SCAN_INTERVAL_SECONDS=300
ALERT_SCORE_THRESHOLD=85
CHAINS=solana,bsc,base,ethereum
MIN_LIQUIDITY_USD=10000
MIN_MARKET_CAP_USD=200000
MAX_MARKET_CAP_USD=30000000
MAX_PAIR_AGE_MINUTES=360
ALERT_COOLDOWN_MINUTES=45
